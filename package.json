{
  "name": "vailsburg-wine-and-liquor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:dry": "ts-node scripts/seedProductsFromCsv.ts --dry-run",
    "seed:products": "ts-node scripts/seedProductsFromCsv.ts",
    "backfill:name-lower:dry": "ts-node scripts/backfillNameLower.ts --dry-run",
    "backfill:name-lower": "ts-node scripts/backfillNameLower.ts",
    "images:backfill:dry": "ts-node --project tsconfig.scripts.json scripts/backfillProductImageMatchFields.ts --dry-run",
    "images:backfill": "ts-node --project tsconfig.scripts.json scripts/backfillProductImageMatchFields.ts",
    "images:index": "ts-node --project tsconfig.scripts.json scripts/indexLocalProductImages.ts",
    "images:match": "ts-node --project tsconfig.scripts.json scripts/matchIndexedImagesToProducts.ts",
    "images:attach:dry": "ts-node --project tsconfig.scripts.json scripts/attachApprovedImages.ts --dry-run",
    "images:attach": "ts-node --project tsconfig.scripts.json scripts/attachApprovedImages.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.4",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "next": "16.1.4",
    "nodemailer": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "stripe": "^20.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true
    }
  }
